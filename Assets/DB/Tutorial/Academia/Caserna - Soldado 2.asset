  m_Script: {fileID: 11500000, guid: fa3089f4c9cbdf6489740b351203c6a0, type: 3}
  m_Name: Caserna - Soldado 2
  m_EditorClassIdentifier: Assembly-CSharp::TutorialData
  id: Caserna - Soldado 2
  description: "Reabaste\xE7a o Helicoptero e saia pelo mar ao norte"
  objectives:
  - id: SUPPLY_UNIT
    key: ex_01
    parameters: CH
    description: "Escolte o caminh\xE3o e reabaste\xE7a o Chinook"
    startHidden: 1
    isVisible: 0
    isCompleted: 0
    isOptional: 0
    isInternal: 0
    isDefeatCondition: 0
    defeatText: 
    announceText: 
    completeCommand: 
    activeUntilKey: 
    hasFailed: 0
  - id: UNIT_DEAD
    key: ex_04
    parameters: CH
    description: "N\xE3o perca o Chinook"
    startHidden: 1
    isVisible: 0
    isCompleted: 0
    isOptional: 0
    isInternal: 0
    isDefeatCondition: 1
    defeatText: Derrubaram o Chinook... poxa, soldado, perdemos nossa carona pra
      casa.
    announceText: 
    completeCommand: 
    activeUntilKey: 
    hasFailed: 0
  - id: PLAYER_ELIMINATED
    key: ex_05
    parameters: 
    description: "N\xE3o perca todas as unidades"
    startHidden: 1
    isVisible: 0
    isCompleted: 0
    isOptional: 0
    isInternal: 0
    isDefeatCondition: 1
    defeatText: "Mais uma derrota para Auridia. Melhor sorte na pr\xF3xima."
    announceText: 
    completeCommand: 
    activeUntilKey: 
    hasFailed: 0
  - id: UNIT_DEAD
    key: ex_06
    parameters: ST
    description: "N\xE3o perca o caminh\xE3o antes de reabastecer"
    startHidden: 1
    isVisible: 0
    isCompleted: 0
    isOptional: 0
    isInternal: 0
    isDefeatCondition: 1
    defeatText: "Perdemos o caminh\xE3o... sem combust\xEDvel, o Chinook n\xE3o sai
      mais do ch\xE3o."
    announceText: 
    completeCommand: 
    activeUntilKey: ex_01
    hasFailed: 0
  - id: UNIT_DEAD
    key: ex_07
    parameters: CH || AUT=0 && LANDED
    description: "Chinook em pouso for\xE7ado"
    startHidden: 0
    isVisible: 1
    isCompleted: 0
    isOptional: 1
    isInternal: 1
    isDefeatCondition: 0
    defeatText: 
    announceText: "[vermelho]R\xE1dio da Capit\xE3 Moura:[/vermelho] \"Secou o tanque,
      tive que descer! No ch\xE3o a metralhadora n\xE3o dispara e o Chinook vira
      alvo f\xE1cil. [ordem]Tragam esse combust\xEDvel r\xE1pido![/ordem]\""
    completeCommand: 
    activeUntilKey: 
    hasFailed: 0
  - id: UNITS_NEAR
    key: ex_10
    parameters: ST && CH && servico
    description: "Chinook no alcance de servi\xE7o do caminh\xE3o"
    startHidden: 0
    isVisible: 1
    isCompleted: 0
    isOptional: 1
    isInternal: 1
    isDefeatCondition: 0
    defeatText: 
    announceText: "[amarelo]O Comando liberou 240 para o reabastecimento.[/amarelo]
      [enfase]O combust\xEDvel do Chinook vem antes de tudo.[/enfase]"
    completeCommand: money +240
    activeUntilKey: 
    hasFailed: 0
  script:
  - advance: 0
    objectiveKey: ex_05
    revealObjective: 1
    waitObjectiveKey: 
    waitObjectiveIndex: -1
    waitAllUnitsActed: 0
    waitPlayerTurnStart: 0
    text: "A f\xE1brica caiu, mas a Metalion fechou o cerco. Hora de sair desta ilha.
      A Capit\xE3 Moura vem buscar voc\xEAs com o Chinook."
    voice: {fileID: 0}
    spawnCommand: 
    statCommand: acted CH; cursor CH
    turn: 1
    movement: 1
    interactionType: 0
    unlockMovement: 0
    revealObjectiveKey: 
    revealObjectiveIndex: -1
  - advance: 0
    objectiveKey: ex_04
    revealObjective: 1
    waitObjectiveKey: 
    waitObjectiveIndex: -1
    waitAllUnitsActed: 0
    waitPlayerTurnStart: 0
    text: "Problema: o Chinook est\xE1 [enfase]quase seco[/enfase]. Helic\xF3ptero
      queima combust\xEDvel todo turno. Quando zerar, ele faz [enfase]pouso for\xE7ado[/enfase]
      onde estiver, e n\xE3o decola mais sem reabastecer."
    voice: {fileID: 0}
    spawnCommand: 
    statCommand: 
    turn: 0
    movement: 0
    interactionType: 0
    unlockMovement: 0
    revealObjectiveKey: 
    revealObjectiveIndex: -1
  - advance: 0
    objectiveKey: ex_06
    revealObjective: 1
    waitObjectiveKey: 
    waitObjectiveIndex: -1
    waitAllUnitsActed: 0
    waitPlayerTurnStart: 0
    text: "O combust\xEDvel est\xE1 aqui, no caminh\xE3o. E entre ele e o Chinook
      tem soldado da Metalion. [enfase]O caminh\xE3o n\xE3o atira[/enfase]: quem
      protege ele s\xE3o voc\xEAs."
    voice: {fileID: 0}
    spawnCommand: 
    statCommand: cursor ST; wake CH
    turn: 0
    movement: 0
    interactionType: 0
    unlockMovement: 0
    revealObjectiveKey: 
    revealObjectiveIndex: -1
  - advance: 4
    objectiveKey: ex_01
    revealObjective: 1
    waitObjectiveKey: 
    waitObjectiveIndex: -1
    waitAllUnitsActed: 0
    waitPlayerTurnStart: 0
    text: "[ordem]Escolte o caminh\xE3o at\xE9 o Chinook e reabaste\xE7a.[/ordem]
      Sem o caminh\xE3o, o Chinook n\xE3o sai mais do ch\xE3o. [azul]Dica: use a
      montanha pr\xF3xima. L\xE1 em cima voc\xEAs t\xEAm uma posi\xE7\xE3o defensiva
      melhor contra as tropas da Metalion.[/azul]"
    voice: {fileID: 0}
    spawnCommand: 
    statCommand: victory morro#1 on; victory morro#2 on
    turn: 2
    movement: 3
    interactionType: 0
    unlockMovement: 0
    revealObjectiveKey: 
    revealObjectiveIndex: -1
  - advance: 1
    objectiveKey: ex_01
    revealObjective: 0
    waitObjectiveKey: 
    waitObjectiveIndex: -1
    waitAllUnitsActed: 0
    waitPlayerTurnStart: 0
    text: 
    voice: {fileID: 0}
    spawnCommand: 
    statCommand: victory morro#1 off; victory morro#2 off
    turn: 0
    movement: 0
    interactionType: 0
    unlockMovement: 0
    revealObjectiveKey: 
    revealObjectiveIndex: -1
