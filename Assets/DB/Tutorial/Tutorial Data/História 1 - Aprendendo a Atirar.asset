  script:
  - advance: 0
    objectiveKey: 
    revealObjective: 0
    waitObjectiveKey: 
    waitObjectiveIndex: -1
    waitAllUnitsActed: 0
    waitPlayerTurnStart: 0
    text: "Bem-vindo, recruta. J\xE1 encheu o bucho com a comida da caserna e tomou
      o caf\xE9 que parece \xF3leo diesel?"
    voice: {fileID: 0}
    spawnCommand: 
    statCommand: 
    turn: 1
    movement: 0
    interactionType: 1
    unlockMovement: 0
    revealObjectiveKey: 
    revealObjectiveIndex: -1
  - advance: 0
    objectiveKey: hist_1_01
    revealObjective: 1
    waitObjectiveKey: 
    waitObjectiveIndex: -1
    waitAllUnitsActed: 0
    waitPlayerTurnStart: 0
    text: "Recruta Ryan, certo? Voc\xEA \xE9 o n\xFAmero 17. Em fila, soldado.\n\n[ordem]Selecione
      sua unidade.[/ordem]"
    voice: {fileID: 0}
    spawnCommand: slot0 SD 1,3 name=Ryan cursor active
    statCommand: 
    turn: 0
    movement: 0
    interactionType: 1
    unlockMovement: 0
    revealObjectiveKey: 
    revealObjectiveIndex: -1
  - advance: 1
    objectiveKey: 
    revealObjective: 0
    waitObjectiveKey: 
    waitObjectiveIndex: -1
    waitAllUnitsActed: 0
    waitPlayerTurnStart: 0
    text: "Essa \xE1rea azul \xE9 onde voc\xEA anda. Tr\xEAs casas em terreno normal.\n\n[ordem]Agora
      anda.[/ordem]"
    voice: {fileID: 0}
    spawnCommand: 
    statCommand: 
    turn: 0
    movement: 3
    interactionType: 3
    unlockMovement: 0
    revealObjectiveKey: hist_1_01
    revealObjectiveIndex: -1
  - advance: 0
    objectiveKey: 
    revealObjective: 0
    waitObjectiveKey: hist_1_01
    waitObjectiveIndex: -1
    waitAllUnitsActed: 0
    waitPlayerTurnStart: 0
    text: "Aquela bandeira no topo. Sobe e pega.\n\nMas montanha come perna: duas
      casas de esfor\xE7o por uma de avan\xE7o."
    voice: {fileID: 0}
    spawnCommand: show Bandeira; pan Bandeira
    statCommand: 
    turn: 0
    movement: 0
    interactionType: 1
    unlockMovement: 0
    revealObjectiveKey: 
    revealObjectiveIndex: -1
  - advance: 2
    objectiveKey: hist_1_02
    revealObjective: 1
    waitObjectiveKey: 
    waitObjectiveIndex: -1
    waitAllUnitsActed: 0
    waitPlayerTurnStart: 0
    text: '[ordem]Sobe o morro, recruta.[/ordem]'
    voice: {fileID: 0}
    spawnCommand: 
    statCommand: 
    turn: 0
    movement: 3
    interactionType: 3
    unlockMovement: 0
    revealObjectiveKey: hist_1_02
    revealObjectiveIndex: -1
  - advance: 4
    objectiveKey: 
    revealObjective: 0
    waitObjectiveKey: 
    waitObjectiveIndex: -1
    waitAllUnitsActed: 1
    waitPlayerTurnStart: 0
    text: "Pernas curtas? N\xE3o chega num turno s\xF3.\n\n[ordem]Passe a vez.[/ordem]
      Amanh\xE3 a gente sobe o resto."
    voice: {fileID: 0}
    spawnCommand: 
    statCommand: 
    turn: 2
    movement: 0
    interactionType: 1
    unlockMovement: 0
    revealObjectiveKey: 
    revealObjectiveIndex: -1
  - advance: 3
    objectiveKey: 
    revealObjective: 0
    waitObjectiveKey: 
    waitObjectiveIndex: -1
    waitAllUnitsActed: 0
    waitPlayerTurnStart: 0
    text: 
    voice: {fileID: 0}
    spawnCommand: 
    statCommand: 
    turn: 1
    movement: 0
    interactionType: 0
    unlockMovement: 0
    revealObjectiveKey: 
    revealObjectiveIndex: -1
  - advance: 1
    objectiveKey: hist_1_02
    revealObjective: 0
    waitObjectiveKey: 
    waitObjectiveIndex: -1
    waitAllUnitsActed: 0
    waitPlayerTurnStart: 1
    text: 'Dia novo, pernas descansadas.


      [ordem]Sobe o resto e pega a bandeira.[/ordem]'
    voice: {fileID: 0}
    spawnCommand: 
    statCommand: pan Ryan
    turn: 0
    movement: 3
    interactionType: 3
    unlockMovement: 0
    revealObjectiveKey: 
    revealObjectiveIndex: -1
  - advance: 4
    objectiveKey: 
    revealObjective: 0
    waitObjectiveKey: hist_1_02
    waitObjectiveIndex: -1
    waitAllUnitsActed: 0
    waitPlayerTurnStart: 0
    text: "Miss\xE3o dada \xE9 miss\xE3o cumprida, 17.\n\n[ordem]Passe a vez para
      retirar a bandeira.[/ordem]"
    voice: {fileID: 0}
    spawnCommand: 
    statCommand: 
    turn: 2
    movement: 0
    interactionType: 1
    unlockMovement: 0
    revealObjectiveKey: 
    revealObjectiveIndex: -1
  - advance: 3
    objectiveKey: 
    revealObjective: 0
    waitObjectiveKey: 
    waitObjectiveIndex: -1
    waitAllUnitsActed: 0
    waitPlayerTurnStart: 0
    text: 
    voice: {fileID: 0}
    spawnCommand: slot1 SD 7,-2 acted
    statCommand: pan 7,-2
    turn: 1
    movement: 0
    interactionType: 2
    unlockMovement: 0
    revealObjectiveKey: 
    revealObjectiveIndex: -1
  - advance: 0
    objectiveKey: 
    revealObjective: 0
    waitObjectiveKey: 
    waitObjectiveIndex: -1
    waitAllUnitsActed: 0
    waitPlayerTurnStart: 0
    text: Espere! Movimento na estrada. Soldados inimigos a vista!
    voice: {fileID: 0}
    spawnCommand: 
    statCommand: pan 7,-2
    turn: 1
    movement: 0
    interactionType: 1
    unlockMovement: 0
    revealObjectiveKey: 
    revealObjectiveIndex: -1
  - advance: 0
    objectiveKey: 
    revealObjective: 0
    waitObjectiveKey: 
    waitObjectiveIndex: -1
    waitAllUnitsActed: 0
    waitPlayerTurnStart: 0
    text: "Voc\xEA tem a montanha. Ele ainda n\xE3o te viu.\n\n[ordem]Mira e confirma.[/ordem]"
    voice: {fileID: 0}
    spawnCommand: 
    statCommand: pan Ryan
    turn: 1
    movement: 4
    interactionType: 1
    unlockMovement: 0
    revealObjectiveKey: 
    revealObjectiveIndex: -1
  - advance: 5
    objectiveKey: hist_1_03
    revealObjective: 1
    waitObjectiveKey: 
    waitObjectiveIndex: -1
    waitAllUnitsActed: 0
    waitPlayerTurnStart: 0
    text: "Alvo v\xE1lido. [ordem]Confirme o ataque.[/ordem]"
    voice: {fileID: 0}
    spawnCommand: 
    statCommand: 
    turn: 1
    movement: 4
    interactionType: 3
    unlockMovement: 0
    revealObjectiveKey: hist_1_03
    revealObjectiveIndex: -1
  - advance: 1
    objectiveKey: hist_1_04
    revealObjective: 1
    waitObjectiveKey: 
    waitObjectiveIndex: -1
    waitAllUnitsActed: 0
    waitPlayerTurnStart: 0
    text: "Resultado registrado. Sem dado escondido, sem desculpa. O resultado veio
      da sua posi\xE7\xE3o.\n\nIsso \xE9 combate."
    voice: {fileID: 0}
    spawnCommand: 
    statCommand: 
    turn: 2
    movement: 0
    interactionType: 4
    unlockMovement: 0
    revealObjectiveKey: hist_1_04
    revealObjectiveIndex: -1
  - advance: 0
    objectiveKey: 
    revealObjective: 0
    waitObjectiveKey: 
    waitObjectiveIndex: -1
    waitAllUnitsActed: 0
    waitPlayerTurnStart: 0
    text: "Primeira li\xE7\xE3o: marchar, conquistar e atirar.\n\nAmanh\xE3 a gente
      v\xEA se voc\xEA faz isso sem eu gritando. No ch\xE3o, recruta!"
    voice: {fileID: 0}
    spawnCommand: 
    statCommand: complete hist_1_04
    turn: 0
    movement: 0
    interactionType: 1
    unlockMovement: 0
    revealObjectiveKey: 
    revealObjectiveIndex: -1
  dialogFlowMigrated: 1
  scoldEndTurnLocked:
    text: Eu ainda estou falando, recruta! Aguarde a ordem para passar a vez.
    voice: {fileID: 0}
  scoldCommandService:
    text: "Servi\xE7o do Comando? Voc\xEA ainda n\xE3o ganhou esse brinquedo, recruta."
    voice: {fileID: 0}
  scoldRemoveUnit:
    text: "Dispensar unidade? Ningu\xE9m dispensa ningu\xE9m sem a minha ordem, recruta."
    voice: {fileID: 0}
  scoldSurrender:
    text: Render-se?! No meu treinamento?! Nem pensar, recruta.
    voice: {fileID: 0}
  scoldStatusSummary:
    text: "Relat\xF3rio \xE9 depois da miss\xE3o. Agora preste aten\xE7\xE3o na li\xE7\xE3o,
      recruta."
    voice: {fileID: 0}
  scoldMovementLocked:
    text: "Quem mandou marchar, recruta?! Eu ainda n\xE3o dei ordem de movimento."
    voice: {fileID: 0}
  scoldHoldPosition:
    text: "Ningu\xE9m desce desse morro, recruta! A ordem \xE9 SEGURAR a posi\xE7\xE3o."
    voice: {fileID: 0}
  scoldAttackOrder:
    text: "A ordem \xE9 MIRAR recruta!"
    voice: {fileID: 0}
  alwaysActedUnits: Mathias; Dias
